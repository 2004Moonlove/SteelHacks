# Copy values into your local shell before starting the backend.
# This file is documentation only; Spring Boot does not load it automatically.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_TIMEOUT_SECONDS=60

# Optional for the selected Nemotron model: none, low, or high.
# Leave empty to retain the provider default.
NVIDIA_REASONING_EFFORT=low
