{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "decisionId": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "factors": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "reason": {
            "type": "string",
            "maxLength": 1000
          },
          "optionIds": {
            "minItems": 1,
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,80}$"
            }
          },
          "dataType": {
            "type": "string",
            "enum": [
              "number",
              "money",
              "duration",
              "date",
              "boolean",
              "category",
              "text"
            ]
          },
          "unit": {
            "type": "string",
            "maxLength": 40
          },
          "allowedValues": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 100
            }
          },
          "direction": {
            "type": "string",
            "enum": [
              "lower",
              "higher",
              "target",
              "none"
            ]
          },
          "purpose": {
            "type": "string",
            "enum": [
              "hard",
              "preference",
              "reference"
            ]
          },
          "importance": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "target": {
            "type": "object",
            "properties": {
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "equals": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": -1000000000000,
                    "maximum": 1000000000000
                  },
                  {
                    "type": "string",
                    "maxLength": 2000
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          "values": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,80}$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": -1000000000000,
                      "maximum": 1000000000000
                    },
                    {
                      "type": "string",
                      "maxLength": 2000
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "source": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "user",
                        "model_suggestion",
                        "demo",
                        "material",
                        "assumption",
                        "unknown"
                      ]
                    },
                    "note": {
                      "type": "string",
                      "maxLength": 2000
                    },
                    "materialId": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9_-]{1,80}$"
                    },
                    "quote": {
                      "type": "string",
                      "maxLength": 2000
                    }
                  },
                  "required": [
                    "kind",
                    "note"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "value",
                "source"
              ],
              "additionalProperties": false
            }
          },
          "source": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "user",
                  "model_suggestion",
                  "demo",
                  "material",
                  "assumption",
                  "unknown"
                ]
              },
              "note": {
                "type": "string",
                "maxLength": 2000
              },
              "materialId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,80}$"
              },
              "quote": {
                "type": "string",
                "maxLength": 2000
              }
            },
            "required": [
              "kind",
              "note"
            ],
            "additionalProperties": false
          },
          "confirmed": {
            "type": "boolean"
          },
          "ruleId": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "upfront",
                  "recurring",
                  "billing_months",
                  "per_use",
                  "time_per_use",
                  "time_monthly",
                  "commitment_months"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "reason",
          "optionIds",
          "dataType",
          "unit",
          "allowedValues",
          "direction",
          "purpose",
          "importance",
          "target",
          "values",
          "source",
          "confirmed",
          "ruleId"
        ],
        "additionalProperties": false
      }
    },
    "questions": {
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "decisionId",
    "version",
    "factors",
    "questions"
  ],
  "additionalProperties": false
}
