{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,80}$"
    },
    "version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 8000
    },
    "domain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "decisionType": {
      "type": "string",
      "enum": [
        "choose_one",
        "buy_or_not",
        "continue_or_exit",
        "now_or_later",
        "other"
      ]
    },
    "goals": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 1000
          },
          "basis": {
            "type": "string",
            "enum": [
              "explicit",
              "suggested"
            ]
          }
        },
        "required": [
          "text",
          "basis"
        ],
        "additionalProperties": false
      }
    },
    "currency": {
      "type": "string",
      "enum": [
        "USD",
        "CNY",
        "EUR",
        "GBP"
      ]
    },
    "context": {
      "type": "object",
      "properties": {
        "months": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "usesPerWeek": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 168
            },
            {
              "type": "null"
            }
          ]
        },
        "budgetCents": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000000
            },
            {
              "type": "null"
            }
          ]
        },
        "budgetScope": {
          "type": "string",
          "enum": [
            "total",
            "first_payment"
          ]
        },
        "source": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "user",
                "model_suggestion",
                "demo",
                "material",
                "assumption",
                "unknown"
              ]
            },
            "note": {
              "type": "string",
              "maxLength": 2000
            },
            "materialId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,80}$"
            },
            "quote": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "required": [
            "kind",
            "note"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "months",
        "usesPerWeek",
        "budgetCents",
        "budgetScope",
        "source"
      ],
      "additionalProperties": false
    },
    "options": {
      "minItems": 2,
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "maxLength": 1000
          },
          "materials": {
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]{1,80}$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 150
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12000
                }
              },
              "required": [
                "id",
                "title",
                "text"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "materials"
        ],
        "additionalProperties": false
      }
    },
    "factors": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "reason": {
            "type": "string",
            "maxLength": 1000
          },
          "optionIds": {
            "minItems": 1,
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,80}$"
            }
          },
          "dataType": {
            "type": "string",
            "enum": [
              "number",
              "money",
              "duration",
              "date",
              "boolean",
              "category",
              "text"
            ]
          },
          "unit": {
            "type": "string",
            "maxLength": 40
          },
          "allowedValues": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 100
            }
          },
          "direction": {
            "type": "string",
            "enum": [
              "lower",
              "higher",
              "target",
              "none"
            ]
          },
          "purpose": {
            "type": "string",
            "enum": [
              "hard",
              "preference",
              "reference"
            ]
          },
          "importance": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "target": {
            "type": "object",
            "properties": {
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "equals": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": -1000000000000,
                    "maximum": 1000000000000
                  },
                  {
                    "type": "string",
                    "maxLength": 2000
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          "values": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,80}$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": -1000000000000,
                      "maximum": 1000000000000
                    },
                    {
                      "type": "string",
                      "maxLength": 2000
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "source": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "user",
                        "model_suggestion",
                        "demo",
                        "material",
                        "assumption",
                        "unknown"
                      ]
                    },
                    "note": {
                      "type": "string",
                      "maxLength": 2000
                    },
                    "materialId": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9_-]{1,80}$"
                    },
                    "quote": {
                      "type": "string",
                      "maxLength": 2000
                    }
                  },
                  "required": [
                    "kind",
                    "note"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "value",
                "source"
              ],
              "additionalProperties": false
            }
          },
          "source": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "user",
                  "model_suggestion",
                  "demo",
                  "material",
                  "assumption",
                  "unknown"
                ]
              },
              "note": {
                "type": "string",
                "maxLength": 2000
              },
              "materialId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,80}$"
              },
              "quote": {
                "type": "string",
                "maxLength": 2000
              }
            },
            "required": [
              "kind",
              "note"
            ],
            "additionalProperties": false
          },
          "confirmed": {
            "type": "boolean"
          },
          "ruleId": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "upfront",
                  "recurring",
                  "billing_months",
                  "per_use",
                  "time_per_use",
                  "time_monthly",
                  "commitment_months"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "reason",
          "optionIds",
          "dataType",
          "unit",
          "allowedValues",
          "direction",
          "purpose",
          "importance",
          "target",
          "values",
          "source",
          "confirmed",
          "ruleId"
        ],
        "additionalProperties": false
      }
    },
    "primaryFactorId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,80}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "questions": {
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "charts": {
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "cost_bar",
          "cumulative_cost",
          "time_bar"
        ]
      }
    },
    "origin": {
      "type": "string",
      "enum": [
        "manual",
        "demo",
        "model"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "title",
    "description",
    "domain",
    "decisionType",
    "goals",
    "currency",
    "context",
    "options",
    "factors",
    "primaryFactorId",
    "questions",
    "charts",
    "origin"
  ],
  "additionalProperties": false
}
